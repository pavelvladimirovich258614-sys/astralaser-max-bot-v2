# =============================================================
# astralaser-max-bot v2.0 — пример переменных окружения
# =============================================================
# 1. Скопируй этот файл: cp .env.example .env
# 2. Заполни реальными значениями
# 3. ВАЖНО: .env в .gitignore — никогда не коммить!
# =============================================================

# --- MAX API ---
# Токен бота, выданный @business_bot. Передаётся в заголовке Authorization.
# НЕ передавать как ?access_token=... — это устарело с 20.04.2026.
MAX_BOT_TOKEN=твой_токен_от_business_bot

# Базовый URL MAX API (можно не менять)
MAX_API_BASE_URL=https://platform-api.max.ru

# --- Webhook ---
# Публично доступный HTTPS URL твоего бота
# Локальная разработка: ngrok / pinggy / cloudflare tunnel
# Production: https://astrabot.example.com/webhook
WEBHOOK_URL=https://example.com/webhook

# Порт, на котором поднимается uvicorn
APP_PORT=8000

# --- База данных ---
# DEV: SQLite
DATABASE_URL=sqlite+aiosqlite:///./astralaser.db

# PROD (раскомментировать на сервере, заменить значения):
# DATABASE_URL=postgresql+asyncpg://astralaser_user:strong_password@localhost:5432/astralaser_prod

# --- Админы ---
# Список user_id (через запятую) — кто имеет доступ к /admin
# Найти свой user_id: написать боту, посмотреть в логах update.message.user.id
MAX_ADMIN_USER_IDS=4147438,73412011

# --- Менеджер (для /contact) ---
MANAGER_NAME=Анастасия
MANAGER_PHONE=+7 903 348 92 05
MANAGER_VK_LINK=https://vk.com/pk_astralazer
# Прямая ссылка на менеджера в MAX (если есть)
MAX_MANAGER_LINK=

# --- Канал для проверки подписки (F09) ---
# Если пусто — gate отключён, бот сразу пускает в FSM оформления
# Если задано — например: @astralazer_official или chat_id канала
MAX_REQUIRED_CHANNEL=
# URL канала для кнопки [📢 Перейти в канал]
MAX_REQUIRED_CHANNEL_URL=https://max.ru/astralazer_official

# --- Логирование ---
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# --- Прочее ---
# Таймаут httpx для запросов к MAX API (секунды)
HTTP_TIMEOUT=30

# Часы работы менеджера для отображения клиенту
WORKING_HOURS=пн–сб 10:00–18:00 МСК
